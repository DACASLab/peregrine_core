<root BTCPP_format="4">

  <BehaviorTree ID="CircleWithSafety">
    <Sequence>
      <WaitUntilReady timeout_s="300.0" settle_s="3.0"/>
      <ReactiveFallback>
        <ReactiveSequence>
          <IsSafetyNominal/>
          <Sequence>
            <TakeoffAction altitude_m="5.0" climb_velocity_mps="1.0"/>
            <ExecuteTrajectoryAction trajectory_type="circle" params="2.0,0.6,2"/>
            <LandAction descent_velocity_mps="0.8"/>
          </Sequence>
        </ReactiveSequence>
        <LandAction descent_velocity_mps="1.0" name="SafetyLand"/>
      </ReactiveFallback>
    </Sequence>
  </BehaviorTree>

</root>
