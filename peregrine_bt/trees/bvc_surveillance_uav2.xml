<root BTCPP_format="4">

  <include path="subtrees/preflight_and_takeoff.xml"/>

  <!--
    BVC test mission — UAV2. Same altitude as UAV1 (2 m) and sweeps each ROW from the
    OPPOSITE end at the same time, so the two UAVs run head-on toward each other along
    every row (bottom row, then top row) — two genuine same-altitude crossings that the
    Buffered Voronoi Cell layer (with right-hand-rule) must resolve, instead of the
    single crossing of the diagonally-opposite pattern. Cell sequence: 2 -> 1 -> 0 ->
    3 -> 4 -> 5 (UAV1 runs 0 -> 1 -> 2 -> 5 -> 4 -> 3).
  -->

  <BehaviorTree ID="BvcSurveillanceUav2">
    <Fallback>
      <Sequence>
        <SubTree ID="PreflightAndTakeoff" altitude_m="2.0"/>
        <WaitAction duration_s="2.0"/>
        <ExecuteTrajectoryAction
          trajectory_type="coverage_sweep"
          params="13.015583,77.561402,5.0,3,2,2.0,0.5,1.5,6,2,1,0,3,4,5"/>
        <WaitAction duration_s="2.0"/>
        <LandAction descent_velocity_mps="0.8"/>
      </Sequence>
      <LandAction descent_velocity_mps="0.8"/>
    </Fallback>
  </BehaviorTree>

</root>
