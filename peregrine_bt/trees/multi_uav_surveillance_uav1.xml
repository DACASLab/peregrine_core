<root BTCPP_format="4">

  <include path="subtrees/preflight_and_takeoff.xml"/>

  <!--
    Multi-UAV surveillance: UAV1 sweeps all 6 cells bottom-right then top-left.
    Cell sequence: 0 -> 1 -> 2 -> 5 -> 4 -> 3

    UAV2 runs the opposite pattern (see multi_uav_surveillance_uav2.xml).
    At matching progress fractions, UAV1 and UAV2 are at diagonally opposite
    grid positions, maintaining >= 1 cell diagonal (~7m) separation.
  -->

  <BehaviorTree ID="MultiUavSurveillanceUav1">
    <Fallback>
      <Sequence>
        <SubTree ID="PreflightAndTakeoff" altitude_m="3.0"/>
        <WaitAction duration_s="2.0"/>
        <ExecuteTrajectoryAction
          trajectory_type="coverage_sweep"
          params="13.018481,77.564971,5.0,3,2,3.0,0.5,1.5,6,0,1,2,5,4,3"/>
        <WaitAction duration_s="2.0"/>
        <LandAction descent_velocity_mps="0.8"/>
      </Sequence>
      <LandAction descent_velocity_mps="0.8"/>
    </Fallback>
  </BehaviorTree>

</root>
